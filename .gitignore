# ══════════════════════════════════════════════════════════════
# .gitignore — Time Series Forecasting (PM2.5 Thesis Project)
# ══════════════════════════════════════════════════════════════
# Mục tiêu: Người dùng clone repo → có thể chạy Dashboard demo
# ngay lập tức mà không cần tải thêm file nặng.
# ══════════════════════════════════════════════════════════════

# ── Python ──
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# ── Virtual Environment ──
.venv/

# ── Environment Variables ──
.env
.env.*

# ── IDE / Editor ──
.idea/
.vscode/
*.swp
*.swo

# ── Lint & Quality Caches ──
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Coverage Reports ──
htmlcov/
.coverage
.coverage.*

# ── OS ──
.DS_Store
._*
Thumbs.db
desktop.ini

# ── Security ──
*.key
*.pem

# ══════════════════════════════════════════════════════════════
# Docs — Push PDF, DOCX và hình ảnh thực nghiệm docs/pics/
# ══════════════════════════════════════════════════════════════
docs/**
!docs/**/
!docs/**/*.pdf
!docs/**/*.docx
docs/**/*_backup.docx
!docs/pics/**

# ══════════════════════════════════════════════════════════════
# Dataset — Giữ raw data, loại processed (có thể tái tạo)
# ══════════════════════════════════════════════════════════════
dataset/processed/*
!dataset/processed/.gitkeep
dataset/interim/*
!dataset/interim/.gitkeep
dataset/external/*
!dataset/external/.gitkeep

# ══════════════════════════════════════════════════════════════
# Research — Giữ kết quả thí nghiệm + hình, loại logs + cache
# ══════════════════════════════════════════════════════════════
research/logs/*
!research/logs/.gitkeep
research/cache/*
!research/cache/.gitkeep
research/scripts/

# ══════════════════════════════════════════════════════════════
# Models — Giữ exported (cho demo), loại user_trained (nặng)
# ══════════════════════════════════════════════════════════════
models/user_trained/*
!models/user_trained/.gitkeep

# ══════════════════════════════════════════════════════════════
# Scratch / Temp — Tất cả file tạm, debug
# ══════════════════════════════════════════════════════════════
scratch/
*.log
temp.txt
temp_*.json
missing_dates_report.txt
yearly_coverage.txt
search_results.txt
error.log

# ── Utility scripts (gom nhóm trong scripts/utilities/) ──
# Các script tiện ích một lần đã được chuyển vào scripts/utilities/ và được Git theo dõi

# ── ChromaDB (vector store, có thể tái tạo) ──
.chroma_db/
src/.chroma_db/

# ── UV Cache ──
.uv_cache/

# ── Agents (không push lên github) ──
.agents/
/.agents

# ── Notebooks (hiện tại rỗng) ──
notebooks/*
!notebooks/.gitkeep

# Global Skills & Bundles symlinks
.agents/skills
.agents/bundles
