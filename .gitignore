# ══════════════════════════════════════════════════════════════
# .gitignore — Time Series Forecasting (PM2.5 Thesis Project)
# ══════════════════════════════════════════════════════════════
# Mục tiêu: Người dùng clone repo → có thể chạy Dashboard demo
# ngay lập tức mà không cần tải thêm file nặng.
# ══════════════════════════════════════════════════════════════

# ── Python ──
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# ── Virtual Environment ──
.venv/

# ── Environment Variables ──
.env
.env.*

# ── IDE / Editor ──
.idea/
.vscode/
*.swp
*.swo

# ── Lint & Quality Caches ──
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Coverage Reports ──
htmlcov/
.coverage
.coverage.*

# ── OS ──
.DS_Store
._*
Thumbs.db
desktop.ini

# ── Security ──
*.key
*.pem

# ══════════════════════════════════════════════════════════════
# Docs — Giữ markdown, loại bỏ sách PDF/EPUB (bản quyền + nặng)
# ══════════════════════════════════════════════════════════════
docs/*.pdf
docs/*.epub
docs/*.pptx
docs/litteratures/
docs/references/
docs/templates/
docs/pdf_excerpt.txt

# ══════════════════════════════════════════════════════════════
# Dataset — Giữ raw data, loại processed (có thể tái tạo)
# ══════════════════════════════════════════════════════════════
dataset/processed/
dataset/interim/
dataset/external/

# ══════════════════════════════════════════════════════════════
# Research — Giữ kết quả thí nghiệm + hình, loại logs + cache
# ══════════════════════════════════════════════════════════════
research/logs/
research/cache/
research/scripts/

# ══════════════════════════════════════════════════════════════
# Models — Giữ exported (cho demo), loại user_trained (nặng)
# ══════════════════════════════════════════════════════════════
models/user_trained/

# ══════════════════════════════════════════════════════════════
# Scratch / Temp — Tất cả file tạm, debug
# ══════════════════════════════════════════════════════════════
scratch/
*.log
temp.txt
temp_*.json
missing_dates_report.txt
yearly_coverage.txt
search_results.txt
error.log

# ── One-off utility scripts (không phải core pipeline) ──
check_citations.py
check_json.py
download_pdf.py
get_titles.py
patch.py
replace_sankey.py
sankey_replacement.py
scratch_scihub.py
scratch_unpaywall.py
search_crossref.py
update_refs.py

# ── ChromaDB (vector store, có thể tái tạo) ──
.chroma_db/
src/.chroma_db/

# ── Papers (thư mục rỗng hoặc tài liệu tải về) ──
papers/
papers_downloaded/
literature_pdfs/

# ── UV Cache ──
.uv_cache/

# ── Agent Memory (cá nhân, không share) ──
.agent/memory/

# ── Notebooks (hiện tại rỗng) ──
notebooks/
