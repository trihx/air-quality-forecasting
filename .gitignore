# ══════════════════════════════════════════════════════════════
# .gitignore — Time Series Forecasting (PM2.5 Research Codebase)
# ══════════════════════════════════════════════════════════════
# Cấu hình chia sẻ mã nguồn sạch cho Giảng viên / Hội đồng:
# - Giữ lại: Toàn bộ mã nguồn cốt lõi (src/), kiểm thử (tests/),
#   cấu hình dự án (pyproject.toml, Makefile, Dockerfile, README.md),
#   dữ liệu mẫu & mô hình phục vụ chạy demo/kiểm định.
# - Loại bỏ: Toàn bộ tài liệu luận văn (docs/), AI Agents (.agents/),
#   Graphify (graphify-out/), Scripts hỗ trợ biên soạn/export (scripts/),
#   và các file tạm, file Office export, file cache.
# ══════════════════════════════════════════════════════════════

# ── Python / Build & Test Caches ──
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
tests/**/*.db

# ── Virtual Environment & Package Managers ──
.venv/
.uv_cache/
node_modules/

# ── Environment Variables & Secrets ──
.env
.env.*
*.key
*.pem

# ── IDE / Editor / OS Metadata ──
.idea/
.vscode/
*.swp
*.swo
.DS_Store
._*
Thumbs.db
desktop.ini

# ══════════════════════════════════════════════════════════════
# LOẠI BỎ TÀI LIỆU LUẬN VĂN, VĂN BẢN & EXPORTS (DOCS & OFFICE)
# ══════════════════════════════════════════════════════════════
docs/
*.docx
*.pdf
*.pptx
*.xlsx
~$*
*~

# ══════════════════════════════════════════════════════════════
# LOẠI BỎ SCRIPTS BIÊN TẬP, SINH DOCX & TIỆN ÍCH PHỤ TRỢ
# ══════════════════════════════════════════════════════════════
scripts/

# ══════════════════════════════════════════════════════════════
# LOẠI BỎ AI AGENTS, GRAPHIFY & VECTOR DATABASES
# ══════════════════════════════════════════════════════════════
.agents/
graphify-out/
.chroma_db/
src/.chroma_db/

# ══════════════════════════════════════════════════════════════
# DATASET — Giữ cấu trúc & raw data, loại bỏ cache trung gian
# ══════════════════════════════════════════════════════════════
dataset/processed/*
!dataset/processed/.gitkeep
dataset/interim/*
!dataset/interim/.gitkeep
dataset/external/*
!dataset/external/.gitkeep

# ══════════════════════════════════════════════════════════════
# MODELS — Giữ exported (cho demo), loại user_trained (nặng)
# ══════════════════════════════════════════════════════════════
models/user_trained/*
!models/user_trained/.gitkeep

# ══════════════════════════════════════════════════════════════
# RESEARCH — Giữ kết quả mấu chốt, loại bỏ logs & cache
# ══════════════════════════════════════════════════════════════
research/logs/*
!research/logs/.gitkeep
research/cache/*
!research/cache/.gitkeep
research/scripts/

# ══════════════════════════════════════════════════════════════
# SCRATCH & TEMPORARY FILES
# ══════════════════════════════════════════════════════════════
scratch/
*.log
temp.txt
temp_*.json
missing_dates_report.txt
yearly_coverage.txt
search_results.txt
error.log

# ── Notebooks ──
notebooks/*
!notebooks/.gitkeep
