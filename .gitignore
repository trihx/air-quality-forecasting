# ══════════════════════════════════════════════════════════════
# .gitignore — Time Series Forecasting (Academic Code Sharing)
# ══════════════════════════════════════════════════════════════
# Cấu hình chuẩn hóa chia sẻ mã nguồn sạch cho Giảng viên / Hội đồng:
# ✅ GIỮ LẠI ĐỂ CHẠY & ĐÁNH GIÁ:
#    • Mã nguồn ứng dụng cốt lõi: src/ (FastAPI backend, Streamlit dashboard)
#    • Kiểm thử tự động: tests/ (193 unit & validation test cases)
#    • Cấu hình môi trường & triển khai: pyproject.toml, uv.lock, Makefile, Dockerfile, render.yaml
#    • Dữ liệu mẫu & mô hình phục vụ demo: dataset/raw/, models/exported/
#    • Tài liệu hướng dẫn sử dụng: README.md, reproduce.sh, run_dashboard.sh, run_dashboard.bat
#
# ❌ LOẠI BỎ HOÀN TOÀN KHỎI GITHUB:
#    • Tài liệu học thuật cá nhân, bản thảo luận văn, sách tham khảo (docs/, *.docx, *.pdf, *.pptx, *.xlsx, *.epub)
#    • Cấu hình & bộ nhớ AI Agents (.agents/, .ai-devkit*, .claude/, .cursor/, .gemini/, graphify-out/)
#    • Toàn bộ scripts hỗ trợ biên tập, sinh tài liệu & scratch nội bộ (scripts/, scratch/, research/scripts/)
#    • Các tệp nhị phân tạm, database cache, logs và biến môi trường nhạy cảm (.env, *.db, *.sqlite)
# ══════════════════════════════════════════════════════════════

# ── 1. TÀI LIỆU HỌC THUẬT, BẢN THẢO LUẬN VĂN & TẬP TIN OFFICE ──
docs/
*.docx
*.pdf
*.pptx
*.xlsx
*.epub
~$*
*~
Screenshot*.png
*.tmp

# ── 2. HỆ THỐNG AI AGENTS, PROMPTS, KNOWLEDGE GRAPH & CACHE ──
.agents/
.ai-devkit*
.ai-devkit/
.claude/
.cursor/
.gemini/
graphify-out/
.chroma_db/
src/.chroma_db/

# ── 3. SCRIPTS BIÊN SOẠN NỘI BỘ, DOWNLOAD & TIỆN ÍCH PHỤ TRỢ ──
scripts/
scratch/
research/scripts/

# ── 4. CƠ SỞ DỮ LIỆU LOCAL CACHE & SQLITE (GIT-SAFE) ──
.agents/cache/
.ai-devkit/memory.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm
tests/**/*.db
# Giữ lại SQLite database mẫu để Giảng viên chạy demo local tức thì không cần PostgreSQL
!research/experiments/forecasting.db

# ── 5. MÔI TRƯỜNG ẢO, PACKAGE MANAGERS & SECRETS ──
.venv/
.uv_cache/
node_modules/
.env
.env.*
*.key
*.pem

# ── 6. PYTHON BUILDS, RUNTIME & TEST CACHES ──
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── 7. DATASET — Giữ cấu trúc & raw data, loại bỏ cache trung gian ──
dataset/processed/*
!dataset/processed/.gitkeep
dataset/interim/*
!dataset/interim/.gitkeep
dataset/external/*
!dataset/external/.gitkeep

# ── 8. MODELS — Giữ exported (cho demo), loại bỏ user_trained lớn ──
models/user_trained/*
!models/user_trained/.gitkeep

# ── 9. RESEARCH & LOGS — Giữ kết quả quan trọng, loại bỏ file tạm ──
research/logs/*
!research/logs/.gitkeep
research/cache/*
!research/cache/.gitkeep
notebooks/*
!notebooks/.gitkeep
*.log
temp.txt
temp_*.json
missing_dates_report.txt
yearly_coverage.txt
search_results.txt
error.log

# ── 10. IDE & HỆ ĐIỀU HÀNH ──
.idea/
.vscode/
*.swp
*.swo
.DS_Store
._*
Thumbs.db
desktop.ini

# Global Skills & Bundles symlinks
.agents/skills
.agents/bundles
